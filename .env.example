# AI Company — private internal development company
# Target product repository: jungyu128/workpilot

# Feature flag (required for HQ)
INTERNAL_AI_COMPANY_ENABLED=true

# Owner-only access guard (temporary secure gate)
# Set a long random token; visitors must present it via cookie or header.
AI_COMPANY_OWNER_TOKEN=change-me-to-a-long-random-secret
AI_COMPANY_OWNER_ID=owner
AI_COMPANY_OWNER_EMAIL=owner@ai-company.local
AI_COMPANY_OWNER_NAME=CEO Owner

# Optional: allow unauthenticated local access in development only
# AI_COMPANY_DEV_BYPASS_AUTH=1

# WorkPilot GitHub connection (server-only — never expose to client)
WORKPILOT_GITHUB_OWNER=jungyu128
WORKPILOT_GITHUB_REPO=workpilot
WORKPILOT_GITHUB_BRANCH=main
GITHUB_TOKEN=

# Optional Google live connectors (mock connectors used when unset)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# AI_COMPANY_GMAIL_ENABLED=true
# AI_COMPANY_CALENDAR_ENABLED=true
# AI_COMPANY_DRIVE_ENABLED=true
# AI_COMPANY_ALLOW_TEST_CONNECTORS=1

# Prisma (local SQLite for connection audit / future persistence)
DATABASE_URL="file:./dev.db"
